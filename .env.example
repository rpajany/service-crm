# Local MongoDB. If MongoDB authentication is enabled, add credentials to the URI.
MONGODB_URI=mongodb://127.0.0.1:27017/service-crm

# Generate a strong random value; never commit the real .env file.
# Example generation in PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# One-time/controlled onboarding secret. Use a long random value and keep it private.
# Company creation is blocked unless this matches the submitted setup key.
BOOTSTRAP_SECRET=replace_with_a_different_long_random_secret

# Set to true only when the production site is served over HTTPS.
COOKIE_SECURE=false
